{"tmdb":1808980,"tagline":"","synopsis":"This is a documentary closely tied to the life experience of internationally renowned writer Hong Ying. Adapted from her autobiography *Daughter of the River*, it draws on her true story. Through the irreproducible life stories of three generations of women, it revisits the memories of Chongqing, the city on the upper reaches of the Yangtze River, and further reflects on mother-daughter bonds, human emotions and the tangled fates people have faced over nearly a century.","directors":[{"name":"Hong Ying","id":4306835}],"cast":[{"actor":"王小熙","role":"小虹影","photo":"https://image.tmdb.org/t/p/w185/ar2Q5OHpTjQcfxe4IMTw8xYuxrY.jpg","tmdb":6578145},{"actor":"Jiang Yujie","role":"青年虹影","photo":"https://image.tmdb.org/t/p/w185/xaoWIWOi4V46PZbgx4W0jaUT3wO.jpg","tmdb":5439611},{"actor":"Hong Ying","role":"成年虹影","photo":"https://image.tmdb.org/t/p/w185/2T2UTNP7dY3Iw3e4BKIywTIHJdk.jpg","tmdb":4306835},{"actor":"霜白","role":"母亲","photo":"https://image.tmdb.org/t/p/w185/31cAsc2mWjZDOK8dOHmFCYKCIMX.jpg","tmdb":6578147},{"actor":"Ding Sheng Fei","role":"大姐","photo":"https://image.tmdb.org/t/p/w185/5GtWV8U29mlLCi3tA5IiQODXSCG.jpg","tmdb":4455396},{"actor":"邹志勇","role":"父亲","photo":"https://image.tmdb.org/t/p/w185/vO5Ri39QpVrLHdbIWXpvMwiqTTx.jpg","tmdb":6578149},{"actor":"Hu Guangzi","role":"生父","photo":"https://image.tmdb.org/t/p/w185/nG4GEilP4VCqhn1fcZ7PE8IGTCo.jpg","tmdb":4987834},{"actor":"姚唯","role":"历史老师","photo":"https://image.tmdb.org/t/p/w185/e3n2qsSt7ES82TGJ8QzqCaH4Ph7.jpg","tmdb":6578154},{"actor":"王勇","role":"大姐夫","photo":null,"tmdb":6578157},{"actor":"瑟珀","role":"虹影女儿","photo":null,"tmdb":6578158},{"actor":"陈俊博","role":"彩电","photo":null,"tmdb":6578159}],"trailers":[],"official":null,"watch":{},"artwork":{"posters":[["/xaoWIWOi4V46PZbgx4W0jaUT3wO.jpg",514,771]],"backdrops":[],"logos":[]}}