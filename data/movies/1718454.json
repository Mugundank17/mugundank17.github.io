{"tmdb":1718454,"tagline":"","synopsis":"Sinta (Dian Sastrowardoyo), the only daughter of Hartini (Retno Soetarto), inherits the family’s old Wiryo Guest House, a place that holds many memories from the past to the present. Amid the comings and goings of guests, Sinta is reunited with Banawan (Roy Sungkono), her childhood friend and the man she once loved. However, the presence of several other male guests brings with it hope, love, and betrayal, which slowly drag Sinta and her family into various problems.","directors":[{"name":"Nurman Hakim","id":1984090},{"name":"Nan Achnas","id":1188913}],"cast":[{"actor":"Dian Sastrowardoyo","role":"Sinta","photo":"https://image.tmdb.org/t/p/w185/gpAaoQj7oISYKAyOR3MCO2tGc35.jpg","tmdb":121963},{"actor":"Roy Sungkono","role":"Banawan","photo":"https://image.tmdb.org/t/p/w185/j02smYzkPYLaPSpddVwiigkr1LO.jpg","tmdb":1714535},{"actor":"Dimas Aditya","role":"Haris","photo":"https://image.tmdb.org/t/p/w185/jzy7OlHRiheBRk5zLDnCI0QxAYc.jpg","tmdb":1211408},{"actor":"David Ari Wibowo","role":"Arif","photo":null,"tmdb":4061215},{"actor":"Seteng \"Sadja\" Yuniawan","role":"","photo":"https://image.tmdb.org/t/p/w185/fxpMEzlwOrCnMWCcZTOmy9HK70W.jpg","tmdb":3119150},{"actor":"Retno Soetarto","role":"Hartini","photo":null,"tmdb":4801163},{"actor":"Peter Szilagyi","role":"","photo":"https://image.tmdb.org/t/p/w185/t9vGE6pgjuYxWF54MNgE3hrtsFn.jpg","tmdb":6587094},{"actor":"Goetheng Iku Ahkin","role":"","photo":null,"tmdb":2477695},{"actor":"Ojing J. Raharjo","role":"","photo":"https://image.tmdb.org/t/p/w185/yweCClZGeI5yl9vRDPdFltL5BXY.jpg","tmdb":3325206},{"actor":"Cahya Aditya","role":"","photo":null,"tmdb":4701247},{"actor":"Ellen Martha","role":"","photo":null,"tmdb":3325202},{"actor":"Afiza Zahra","role":"","photo":null,"tmdb":6587111}],"trailers":[{"key":"qm1V6xQ8btk","name":"Yang Datang dan Yang Pergi - Official Trailer","type":"Trailer","published":"2026-10-30"}],"official":null,"watch":{},"artwork":{"posters":[],"backdrops":[],"logos":